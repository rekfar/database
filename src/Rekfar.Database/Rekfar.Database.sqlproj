<?xml version="1.0" encoding="utf-8"?>
<!--
  Declarative schema for Rekfar. Every .sql file under this folder is one database
  object; `dotnet build` aggregates them into a .dacpac. See ../../README.md.
-->
<Project Sdk="Microsoft.Build.Sql/2.2.0">
  <PropertyGroup>
    <Name>Rekfar.Database</Name>
    <DacApplicationName>Rekfar</DacApplicationName>
    <DacVersion>0.1.0</DacVersion>

    <!-- Azure SQL Database is the deploy target (ADR-0010 T3). This provider makes the
         build reject anything Azure SQL does not support, so incompatibilities surface
         here rather than at publish time. Local SQL Server 2022 is a superset. -->
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>

    <!-- Norwegian collation, for æ/ø/å sorting of place names. On Azure SQL this is
         fixed when the database is created and CANNOT be changed afterwards, so the
         database must be created to match — see docs/operations.md. -->
    <DefaultCollation>Norwegian_100_CI_AS</DefaultCollation>
    <ModelCollation>1044,CI</ModelCollation>

    <!-- Strict from the start: a clean model has no build warnings, and an unresolved
         reference is always a real defect. If CI ever surfaces a warning that is
         genuinely benign, add its code to SuppressTSqlWarnings with a comment
         explaining why — do not turn this flag off. -->
    <TreatTSqlWarningsAsErrors>true</TreatTSqlWarningsAsErrors>
    <SuppressTSqlWarnings></SuppressTSqlWarnings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Deployment scripts are not schema objects, so they must not be compiled into
         the model. Exactly one PostDeploy file is allowed; it :r-includes the rest. -->
    <Build Remove="Scripts/**/*.sql" />
    <PostDeploy Include="Scripts/PostDeployment/PostDeployment.sql" />
    <None Include="Scripts/PostDeployment/Seed.*.sql" />
  </ItemGroup>
</Project>
